<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.xlythe.hex.view.BoardView
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/exit"
        android:text="@string/game_quit"
        android:textSize="13sp"
        android:paddingBottom="7dp"
        android:textColor="@color/white"
        android:drawableTop="@drawable/exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        style="?android:attr/borderlessButtonStyle" />

    <Button
        android:id="@+id/reload"
        android:text="@string/game_reload"
        android:textSize="13sp"
        android:paddingBottom="7dp"
        android:textColor="@color/white"
        android:drawableTop="@drawable/restart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/exit"
        android:layout_alignParentBottom="true"
        style="?android:attr/borderlessButtonStyle" />

    <Button
        android:id="@+id/undo"
        android:text="@string/game_undo"
        android:textSize="13sp"
        android:paddingBottom="7dp"
        android:textColor="@color/white"
        android:drawableTop="@drawable/undo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/exit"
        style="?android:attr/borderlessButtonStyle" />

    <Button
        android:id="@+id/chat"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/reload"
        android:layout_alignStart="@id/reload"
        android:drawableTop="@drawable/ic_chat"
        android:paddingBottom="7dp"
        android:text="@string/game_chat_button"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone" />

</RelativeLayout>
